# Copie para .env e preencha com suas chaves.
# O painel lê este arquivo em runtime (fetch) quando servido por HTTP.
# Abrindo por file:// o fetch é bloqueado pelo CORS — nesse caso informe as
# chaves pela própria interface (ficam apenas no localStorage do navegador).

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
